{
  "name": "s3-compat-check",
  "version": "0.1.0",
  "description": "S3 compatibility smoke tests in seconds. Check that an S3-compatible object storage implements the basic S3 API correctly.",
  "keywords": [
    "s3",
    "s3-compatible",
    "object-storage",
    "minio",
    "ceph",
    "r2",
    "smoke-test",
    "compatibility",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "akam1o",
    "email": "akam1o@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akam1o/s3-compat-check.git"
  },
  "bugs": {
    "url": "https://github.com/akam1o/s3-compat-check/issues"
  },
  "homepage": "https://github.com/akam1o/s3-compat-check#readme",
  "type": "module",
  "bin": {
    "s3-compat-check": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
